{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend orchestrator + REST API + LangChain content-skill bridge for the Instagram content agent.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp-server.ts",
    "db:migrate": "tsx src/db.ts",
    "model:ping": "tsx scripts/ping-model.ts",
    "agent:ping": "tsx scripts/agent-ping.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@instagram-agent/shared": "workspace:*",
    "@langchain/anthropic": "^0.3.14",
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.3.17",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  }
}
