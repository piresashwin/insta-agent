# Content agent configuration (does NOT hold secrets long-term).
# Localhost works out of the box. For production, use a public URL for the redirect URI.

# Express port
PORT=3001

# ── API security ─────────────────────────────────────────────────────────────
# Set a secret token to protect the API. All /api/* routes require:
#   Authorization: Bearer <OPERATOR_TOKEN>
# If not set, all routes are open (dev mode — log warning appears at startup).
# OPERATOR_TOKEN=change-me-to-a-random-secret

# Network interface to bind to. Default 127.0.0.1 (localhost only).
# Set 0.0.0.0 only inside a container / when LAN access is intentional.
# BIND_HOST=127.0.0.1

# ── Instagram OAuth (Lesson 14) — or paste App ID/secret in the Accounts UI ─
# INSTAGRAM_APP_ID=1234567890
# INSTAGRAM_CLIENT_SECRET=abcdef123456
# Instagram requires HTTPS for browser OAuth callbacks (http://localhost is rejected).
# Prefer local: paste a token from Meta App Dashboard → Generate token (no callback).
# For browser OAuth, use a stable HTTPS host you control (not ephemeral trycloudflare URLs):
# PUBLIC_API_BASE=https://api.yourdomain.com
# INSTAGRAM_REDIRECT_URI=https://api.yourdomain.com/api/auth/instagram/callback
# CLIENT_ORIGIN=http://localhost:5173
# TOKEN_ENCRYPTION_KEY=replace-with-long-random-string
# Dev only — mock Graph connect without Meta (never enable in prod):
# INSTAGRAM_OAUTH_MOCK=true
# INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish

# ── Chat / content skills (OpenAI-compatible: LM Studio, OpenAI, vLLM, …) ─
# Required for the 4 content skills (content-planning, caption-writing,
# image-reel-generation, post-review). Same code path for local or cloud —
# change these env vars only.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=your-local-model-id

# ── GPT Image generation (separate from chat OPENAI_* above) ─────────────
# Used only by POST /api/posts/:id/fetch-media { provider: "openai" }.
# IMAGE_OPENAI_API_KEY=sk-...
# IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_OPENAI_MODEL=gpt-image-2
# IMAGE_OPENAI_QUALITY=auto
# IMAGE_OPENAI_SIZE=1024x1536

# Completion budget (must cover reasoning_tokens + JSON). Default 4096.
# Reasoning models (e.g. bonsai-27b) return empty content if this is too low.
# OPENAI_MAX_TOKENS=4096
# STRUCTURED_OUTPUT_MAX_TOKENS=4096

# Structured skill output. Default promptJson = plain chat + Zod (LM Studio–friendly).
# Alternatives for cloud OpenAI: jsonSchema | jsonMode | functionCalling
# STRUCTURED_OUTPUT_METHOD=promptJson
# STRUCTURED_OUTPUT_TIMEOUT_MS=180000

# Chapter 03 agent loop budgets
# AGENT_MAX_STEPS=12
# AGENT_TIMEOUT_MS=240000
# AGENT_SKIP_RESEARCH=1   # disable topic_research pre-step

# Instagram rules — hashtag cap (Instagram announced 5/post in Dec 2025).
# IG_HASHTAG_MAX=5

# Optional vision QA of model-baked on-image text (advisory badge in Post Studio).
# Needs a vision-capable OpenAI-compatible model; skipped when unset.
# VISION_QA_MODEL=gpt-4o-mini
# VISION_QA_BASE_URL=https://api.openai.com/v1
# VISION_QA_API_KEY=sk-...

# Topic research (optional live web — otherwise model knowledge)
# Prefer one of:
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Demo only: if true, agent-run may return canned text when the model fails.
# Default is off — failed model calls surface as HTTP 502.
# ALLOW_CANNED_FALLBACK=false

# ── Brand (optional, loaded by the agent at task start) ──────────────────
# BRAND_GUIDE_PATH=content/BRAND.md
# BRAND_CONFIG_PATH=config/brand.json

# ── Media sources (keys pasted by the operator in the dashboard) ──────────
# PEXELS_API_KEY=
# UNSPLASH_API_KEY=
# PIXABAY_API_KEY=

# ── Runware (AI reel / video generation) ─────────────────────────────────
# Dashboard: https://my.runware.ai/ — create an API key under API Keys.
# Reels: draft 480×832 (480p ~9:16) → final 768×1344 (768p ~9:16 publish tier).
# MiniMax H3 Max Turbo has no literal 720p pair — 768p is the high tier.
# RUNWARE_API_KEY=
# Optional overrides (defaults match Runware docs):
# RUNWARE_API_BASE_URL=https://api.runware.ai/v1
# RUNWARE_VIDEO_MODEL=minimax:h3@max-turbo
# Fallback clip length when a post has no prompt_vars.duration (agent sets 6–15s per reel).
# RUNWARE_VIDEO_DURATION=8
# RUNWARE_POLL_TIMEOUT_MS=600000

# ── Staged media (Approve media) ──────────────────────────────────────────
# Default: bake PNGs to server/assets/posts/<id>/staged/ and serve at /assets/...
# For Instagram Graph, Meta must fetch those URLs over HTTPS — tunnel the API:
#   cloudflared tunnel --url http://127.0.0.1:3001
#   PUBLIC_API_BASE=https://<your-tunnel-host>
# Optional later: MEDIA_STORAGE=r2 plus R2_* instead of local disk.
# MEDIA_STORAGE=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=instagram-agent-media
# R2_PUBLIC_BASE_URL=https://media.yourdomain.com
